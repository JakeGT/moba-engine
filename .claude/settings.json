{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rust-post-edit.sh",
            "timeout": 300,
            "statusMessage": "rustfmt + cargo check"
          }
        ]
      }
    ]
  }
}
